<!-- 20260628145602 -->
<script>
    function executeClickAction() {
        var side1 = document.getElementById("side1");
        var side2 = document.getElementById("side2");
        var titleIsPreviewer = document.title === "previewer";
        var sound1Selector = "#sound1 .soundLink, .replaybutton";
        var sound2Selector = "#sound2 .soundLink, .replaybutton";

        var clickSoundElement = function (selector) {
            var elem = document.querySelector(selector);
            if (elem) {
                elem.click();
            } else {
                var onLoadHandler = function () {
                    var elem = document.querySelector(selector);
                    if (elem) {
                        elem.click();
                    }
                    window.removeEventListener("load", onLoadHandler);
                };
                window.addEventListener("load", onLoadHandler);
            }
        };

        if (side1 !== null) {
            if (side2 === null) {
                clickSoundElement(sound1Selector);
            } else {
                if (titleIsPreviewer) {
                    clickSoundElement(sound1Selector);
                } else {
                    clickSoundElement(sound2Selector);
                }
            }
        }
    }

    function parseCoordinates(coordsStr) {
        if (!coordsStr || coordsStr.trim() === "") return null;
        var coords = [];
        var parts = coordsStr.split(',');
        for (var i = 0; i < parts.length; i++) {
            var part = parts[i].trim();
            var match = part.match(/^(\d+):(\d+):(\d+)$/);
            if (match) {
                coords.push({ line: parseInt(match[1], 10), word: parseInt(match[2], 10), term_pos: parseInt(match[3], 10) });
            } else {
                var num = parseInt(part, 10);
                if (!isNaN(num)) {
                    coords.push({ line: 0, word: num, term_pos: coords.length + 1 });
                }
            }
        }
        return coords.length > 0 ? coords : null;
    }

    function getCharWordIndices(text) {
        var indices = new Array(text.length);
        var currentWordIndex = 0;
        var inWord = false;
        var isWordCharRegex;
        try {
            isWordCharRegex = new RegExp("[\\p{L}0-9]", "u");
        } catch(e) {
            isWordCharRegex = new RegExp("[a-zA-Z0-9_]");
        }

        for (var i = 0; i < text.length; i++) {
            var char = text[i];
            var isWordChar = isWordCharRegex.test(char);
            
            if (isWordChar) {
                if (!inWord) {
                    currentWordIndex++;
                    inWord = true;
                }
                indices[i] = currentWordIndex;
            } else {
                inWord = false;
                indices[i] = 0;
            }
        }
        return indices;
    }

    function getCoordsError(wIndices, coords) {
        if (!coords || coords.length === 0) return 0;
        var n = coords.length;
        var w_vals = new Array(n);
        for (var i = 0; i < n; i++) {
            w_vals[i] = wIndices[i] !== undefined ? wIndices[i] : (wIndices[wIndices.length - 1] || 0);
        }

        var lineStarts = {};
        for (var i = 0; i < n; i++) {
            var c = coords[i];
            var w = w_vals[i];
            if (lineStarts[c.line] === undefined) {
                lineStarts[c.line] = w - c.word + 1;
            }
        }

        var totalError = 0;
        for (var i = 0; i < n; i++) {
            var c = coords[i];
            var w = w_vals[i];
            var estStart = lineStarts[c.line];
            var expectedW = estStart + c.word - 1;
            totalError += Math.abs(w - expectedW);
            totalError += Math.abs(w - c.word) * 0.1;
        }

        var uniqueLines = Object.keys(lineStarts).map(Number).sort((a, b) => a - b);
        for (var i = 0; i < uniqueLines.length - 1; i++) {
            var l1 = uniqueLines[i];
            var l2 = uniqueLines[i + 1];
            var s1 = lineStarts[l1];
            var s2 = lineStarts[l2];
            if (s2 <= s1) {
                totalError += (s1 - s2 + 1) * 10;
            }
        }

        for (var i = 0; i < n - 1; i++) {
            var c1 = coords[i];
            var c2 = coords[i + 1];
            if (c2.line === c1.line + 1 && c2.term_pos === c1.term_pos + 1) {
                var w1 = w_vals[i];
                var w2 = w_vals[i + 1];
                totalError += Math.abs(w2 - w1 - 1) * 5;
            }
        }

        if (n === 1) {
            totalError += Math.abs(w_vals[0] - coords[0].word);
        }
        return totalError;
    }

    function highlightWords() {
        var sourceIndexStr = "";
        var indexElem = document.getElementById("sentence-source-index");
        if (indexElem) {
            sourceIndexStr = indexElem.textContent.trim();
        }

        highlightField("words-to-highlight", ["#sentence-source", ".sentence-source"], null, sourceIndexStr);
        var destField = document.getElementById("words-destination-to-highlight");
        if (destField && destField.textContent.trim().length > 0) {
            highlightField("words-destination-to-highlight", [".sentence-destination", ".sentence-destination-2"], /[;\n]+/, null);
        } else {
            autoHighlightDestination();
        }
    }

    function autoHighlightDestination() {
        var sourceWordsField = document.getElementById("words-to-highlight");
        var sourceSentenceElem = document.getElementById("sentence-source");
        if (!sourceWordsField || !sourceSentenceElem) return;

        var sourceText = sourceWordsField.textContent.trim();
        if (!sourceText) return;

        // Use textContent to ignore existing HTML tags
        var sourceSentenceText = sourceSentenceElem.textContent;
        var splitRegex;
        try { splitRegex = new RegExp("[^\\p{L}0-9]+", "u"); } catch(e) { splitRegex = new RegExp("[^a-zA-Z0-9_]+"); }
        var sourceWords = sourceSentenceText.split(splitRegex).filter(w => w.length > 0);
        var searchWords = sourceText.split(/[,;\s\n\(\)]+/).filter(w => w.length > 0);

        var sourceIndex = -1;
        for (var i = 0; i < sourceWords.length; i++) {
            for (var j = 0; j < searchWords.length; j++) {
                if (sourceWords[i].toLowerCase() === searchWords[j].toLowerCase()) {
                    sourceIndex = i;
                    break;
                }
            }
            if (sourceIndex !== -1) break;
        }

        if (sourceIndex === -1) return;

        var destElems = document.querySelectorAll(".js-sentence-destination");
        destElems.forEach(function (destElem) {
            var destSentenceText = destElem.textContent;
            var partsRegex;
            try { partsRegex = new RegExp("([^\\p{L}0-9]+)", "u"); } catch(e) { partsRegex = new RegExp("([^a-zA-Z0-9_]+)"); }
            var parts = destSentenceText.split(partsRegex);
            var wordIndices = [];
            for (var k = 0; k < parts.length; k++) {
                if (partsRegex.test(parts[k]) || parts[k].length === 0) continue;
                wordIndices.push(k);
            }

            if (wordIndices.length === 0) return;

            var destIndex = Math.round((sourceIndex / Math.max(1, sourceWords.length)) * wordIndices.length);
            var start = Math.max(0, destIndex - 1);
            var end = Math.min(wordIndices.length - 1, destIndex + 1);

            for (var m = start; m <= end; m++) {
                var partIndex = wordIndices[m];
                parts[partIndex] = "<u>" + parts[partIndex] + "</u>";
            }

            destElem.innerHTML = parts.join("");
            destElem.classList.add("sentence-destination");
        });
    }

    function highlightField(wordsId, targetSelectors, delimiterRegex, coordsStr) {
        var wordsField = document.getElementById(wordsId);
        if (!wordsField) return;

        var sentences = [];
        targetSelectors.forEach(function (sel) {
            var elems = document.querySelectorAll(sel);
            elems.forEach(function (e) { sentences.push(e); });
        });
        if (sentences.length === 0) return;

        var wordsText = wordsField.textContent.trim();
        if (!wordsText) return;

        var coords = parseCoordinates(coordsStr);

        sentences.forEach(function (sentenceElem) {
            var text = sentenceElem.textContent;
            var charWordIndices = getCharWordIndices(text);
            var sentence = sentenceElem.innerHTML;
            var phraseHighlighted = false;

            // Phase 1: Full phrase matching with coordinate disambiguation
            // Matches the entire wordsText as a single unit (aligned with donor project).
            // This ensures all word indices are compared against all coordinates together,
            // which correctly disambiguates when individual words appear multiple times.
            if (coords && coords.length > 0) {
                var escapedPhrase = wordsText.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

                var regexForText, regexForInner;
                try {
                    regexForText = new RegExp("(?<!\\p{L})(" + escapedPhrase + ")(?!\\p{L})", "gui");
                    regexForInner = new RegExp("(?<!\\p{L})(" + escapedPhrase + ")(?!\\p{L})", "gui");
                } catch (e) {
                    regexForText = new RegExp("(^|[^\\w\\p{L}])(" + escapedPhrase + ")(?![\\w\\p{L}])", "gui");
                    regexForInner = new RegExp("(^|[^\\w\\p{L}])(" + escapedPhrase + ")(?![\\w\\p{L}])", "gui");
                }

                var matches = [];
                var m;
                while ((m = regexForText.exec(text)) !== null) {
                    var wordStr = m.length > 2 ? m[2] : m[1];
                    var wordIdx = m.length > 2 ? m.index + m[1].length : m.index;

                    var wIdxList = [];
                    var lastWIdx = 0;
                    for (var i = wordIdx; i < wordIdx + wordStr.length; i++) {
                        var wIdx = charWordIndices[i] || 0;
                        if (wIdx > 0 && wIdx !== lastWIdx) {
                            wIdxList.push(wIdx);
                            lastWIdx = wIdx;
                        }
                    }
                    matches.push({ wIdxList: wIdxList });
                    if (m[0].length === 0) regexForText.lastIndex++;
                }

                if (matches.length > 0) {
                    var bestMatchIdx = -1;
                    var minError = Infinity;
                    for (var i = 0; i < matches.length; i++) {
                        var errVal = getCoordsError(matches[i].wIdxList, coords);
                        if (errVal < minError) {
                            minError = errVal;
                            bestMatchIdx = i;
                        }
                    }

                    if (bestMatchIdx !== -1) {
                        var innerMatches = [];
                        var im;
                        while ((im = regexForInner.exec(sentence)) !== null) {
                            var imWordStr = im.length > 2 ? im[2] : im[1];
                            var imWordIdx = im.length > 2 ? im.index + im[1].length : im.index;

                            var before = sentence.substring(0, imWordIdx);
                            var insideTag = (before.split('<').length - 1) > (before.split('>').length - 1);
                            if (!insideTag) {
                                innerMatches.push({ start: imWordIdx, length: imWordStr.length, str: imWordStr });
                            }
                            if (im[0].length === 0) regexForInner.lastIndex++;
                        }

                        if (innerMatches[bestMatchIdx]) {
                            var target = innerMatches[bestMatchIdx];
                            sentence = sentence.substring(0, target.start) + "<u>" + target.str + "</u>" + sentence.substring(target.start + target.length);
                            phraseHighlighted = true;
                        }
                    }
                }
            }

            // Phase 2: Fallback — individual word highlighting without coordinate disambiguation.
            // Runs when no coordinates are present, or when the full phrase was not found in the text
            // (e.g. comma-separated word lists, or text mismatch).
            if (!phraseHighlighted) {
                var regexDelim = delimiterRegex || /[,;\s\n\(\)]+/;
                var words = wordsText.split(regexDelim).map(function(w) { return w.trim(); }).filter(function(w) { return w.length > 0; });
                words.sort(function(a, b) { return b.length - a.length; });

                words.forEach(function (word) {
                    var escapedWord = word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    var regex;
                    var isModern = true;
                    try {
                        regex = new RegExp("(?<!\\p{L})(" + escapedWord + ")(?!\\p{L})", "gui");
                    } catch (e) {
                        isModern = false;
                        regex = new RegExp("(^|[^\\w\\p{L}])(" + escapedWord + ")(?![\\w\\p{L}])", "gui");
                    }

                    sentence = sentence.replace(regex, function() {
                        var match = arguments[0];
                        var argsLen = arguments.length;
                        var string = arguments[argsLen - 1];
                        var offset = arguments[argsLen - 2];
                        
                        if (typeof string !== "string") {
                            string = arguments[argsLen - 2];
                            offset = arguments[argsLen - 3];
                        }
                        
                        var before = string.substring(0, offset);
                        var insideTag = (before.split('<').length - 1) > (before.split('>').length - 1);
                        
                        if (insideTag) {
                            return match;
                        }
                        
                        if (isModern) {
                            return "<u>" + arguments[1] + "</u>";
                        } else {
                            return arguments[1] + "<u>" + arguments[2] + "</u>";
                        }
                    });
                });
            }

            sentenceElem.innerHTML = sentence;
        });
    }

    function init() {
        executeClickAction();
        highlightWords();
    }

    setTimeout(init, 20);
</script>

